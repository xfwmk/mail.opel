{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mail-opel",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "MAIL_TOKENS",
      "id": "de56d4f95a9244cdb38cffe3e4d943c8"
    }
  ],
  "vars": {
    "ALLOWED_ACCESS_EMAIL": "k11987rn@gmail.com",
    "ALLOWED_GMAIL": "k11987rn@gmail.com"
  }
}
